# ─── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=100week
PORT=5000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# ─── Gmail SMTP (for email notifications) ────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=
STAFF_NOTIFICATION_EMAIL=

# ─── Twilio SMS (for parent absence notifications) ────────────────────────────
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
# Your Twilio-issued phone number in E.164 format, e.g. +14155551234 or +917708585916
TWILIO_PHONE_NUMBER=+91XXXXXXXXXX

# College name shown in SMS messages
COLLEGE_NAME=Thanthai Hans Roever College (Autonomous)

# Set to true to log SMS content without actually calling Twilio (safe for local dev)
SMS_TEST_MODE=false

# ─── MSG91 (legacy — not used when Twilio is configured) ─────────────────────
# MSG91_AUTH_KEY=
# MSG91_ABSENCE_TEMPLATE_ID=
# MSG91_CORRECTION_TEMPLATE_ID=
# MSG91_DELIVERY_WEBHOOK_TOKEN=
